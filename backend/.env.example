# Copy to .env.dev and add a key for the provider you want to use.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Required for the protected workflow. Configure the same agent, MCP, user,
# and policies in the ArmorIQ dashboard.
ARMORIQ_API_KEY=
ARMORIQ_USER_ID=driftlab-demo
ARMORIQ_USER_EMAIL=you@example.com
ARMORIQ_AGENT_ID=driftlab-agent
ARMORIQ_MCP_NAME=driftlab-mcp

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Optional providers, currently disabled in the frontend picker.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5-mini
# CLAUDE_API_KEY=
# CLAUDE_BASE_URL=https://openrouter.ai/api/v1
# CLAUDE_MODEL=anthropic/claude-3.5-sonnet
