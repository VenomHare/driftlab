# Required for real ArmorIQ SDK integration tests/demo.
ARMORIQ_API_KEY=
# Use an email associated with your ArmorIQ organization/policies.
ARMORIQ_USER_EMAIL=you@example.com
# local = SDK's in-process intent/policy check; proxy = remote proxy enforcement.
# Start with local for the included plan-binding proof. Use proxy only after configuring
# the ArmorIQ proxy/MCP registration per the official docs.
ARMORIQ_MODE=local