    "react": "^18.3.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.1",
    "@types/react": "^18.3.20",
    "typescript": "^5.8.3"
  }
}
